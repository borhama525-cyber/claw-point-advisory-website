[{"_1":2},"routes/blog.$slug",{"_3":4},"data",{"_5":6},"article",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18},"slug","prepare-your-funding-enquiry","category","DEAL PREPARATION","title","What to prepare before your first funding call.","excerpt","A practical checklist to make your first conversation more useful.","date","November 7, 2026","body",[19,20,21,22],"Start with a concise outline: the property, the parties, the proposed purchase and onward sale, and the dates each leg is intended to close.","Have the purchase and resale agreements available if they exist. Explain the intended repayment source and whether any conditions remain outstanding.","Know who is handling the closing and what information they need from the funding provider. Do not send confidential identity documents or banking details through a general contact form.","Use the initial call to understand the review process. An introductory discussion does not guarantee approval, terms or funding availability."]
